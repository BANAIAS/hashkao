# HKO Météo — vidéos satellite, toutes les 15 minutes (h + 9, 24, 39, 54)
# Une heure est close à h + 1 h 25 : elle est encodée au passage de h + 1 h 39.
# Décalé des images (h + 2, 7, 12…) : les deux services ne démarrent plus
# ensemble. Un passage vidéo long peut encore croiser un passage images ;
# les limites mémoire (MemoryHigh / MemoryMax) en tiennent compte.
# Activation : sudo systemctl enable --now hko-derives-videos.timer

[Unit]
Description=HKO Météo — vidéos satellite, toutes les 15 minutes

[Timer]
OnCalendar=*:9/15
Persistent=true
RandomizedDelaySec=20
Unit=hko-derives-videos.service

[Install]
WantedBy=timers.target
