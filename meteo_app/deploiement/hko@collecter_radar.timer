# HKO Météo — radar, toutes les 5 minutes
# Activation : sudo systemctl enable --now hko@collecter_radar.timer

[Unit]
Description=HKO Météo — radar, toutes les 5 minutes

[Timer]
OnCalendar=*:3/5
# Rattrape une exécution manquée (serveur redémarré, par exemple)
Persistent=true
# Étale légèrement les appels pour ne pas solliciter les API à la seconde près
RandomizedDelaySec=20
Unit=hko@collecter_radar.service

[Install]
WantedBy=timers.target
