# HKO Météo — stations, toutes les 6 minutes
# Activation : sudo systemctl enable --now hko@collecter_observations.timer

[Unit]
Description=HKO Météo — stations, toutes les 6 minutes

[Timer]
OnCalendar=*:2/6
# Rattrape une exécution manquée (serveur redémarré, par exemple)
Persistent=true
# Étale légèrement les appels pour ne pas solliciter les API à la seconde près
RandomizedDelaySec=20
Unit=hko@collecter_observations.service

[Install]
WantedBy=timers.target
